# =========================================================
# Biometric API - Variables de entorno (ejemplo)
# Copiar a .env y completar con los valores reales.
# NO escribir secretos reales en este archivo.
# =========================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# --- Base de datos PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Redis (broker de Celery) ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Channels (WebSockets) — misma instancia de Redis, otra DB
CHANNELS_REDIS_URL=
# En dev se puede dejar en True para ejecutar tareas síncronas sin worker
CELERY_TASK_ALWAYS_EAGER=

# --- AWS S3 (para PDFs y QRs) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
# Si está vacío, los archivos no se sirven públicamente y se firman URLs
AWS_QUERYSTRING_AUTH=

# --- Frontend (para los enlaces del QR) ---
# Debe ser alcanzable desde el celular que escanea el QR: IP LAN en local
# o el dominio real en producción.
FRONTEND_BASE_URL=

# --- Email (SMTP) ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Destinatarios fijos para notificaciones de programación de mantenimientos (CSV)
MAINTENANCE_NOTIFICATION_EMAILS=

# --- CORS / CSRF (lista separada por comas, con cookies + withCredentials) ---
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
JWT_REFRESH_TOKEN_LIFETIME_DAYS=

# --- Cookies de autenticación (frontend web) ---
# El access/refresh token se entregan como cookies httpOnly, no en el body.
# En prod.py AUTH_COOKIE_SECURE se fuerza a True.
AUTH_COOKIE_SAMESITE=
AUTH_COOKIE_SECURE=

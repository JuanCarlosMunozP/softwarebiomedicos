# Copiar a .env (dev) o .env.production (build de producción) y ajustar.
#
# OJO: Vite empaqueta CUALQUIER variable con prefijo VITE_ directo al
# bundle público del navegador. Nunca poner acá una API key, secreto o
# credencial — solo config no sensible como URLs.

# URL base de la API. En dev, absoluta (host:puerto del backend local).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
